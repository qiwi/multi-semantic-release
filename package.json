{
  "name": "@simspace/multi-semantic-release",
  "author": "Dave Houlbrooke <dave@shax.com>",
  "version": "7.1.5",
  "license": "0BSD",
  "engines": {
    "node": ">=14",
    "yarn": ">=1.0.0"
  },
  "type": "module",
  "exports": {
    ".": "./lib/multiSemanticRelease.js",
    "./*": "./*"
  },
  "bin": {
    "multi-semantic-release": "./bin/cli.js"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "lib",
    "bin"
  ],
  "scripts": {
    "watch": "jest --watchAll",
    "lint": "eslint ./",
    "lint:fix": "eslint --fix ./",
    "test": "yarn lint && yarn test:unit",
    "test:unit": "NODE_OPTIONS=\"${NODE_OPTIONS} --experimental-vm-modules\" ./node_modules/.bin/jest --coverage",
    "build": "echo 'There is no need for build' && exit 0",
    "postupdate": "yarn && npx yarn-audit-fix && yarn build && yarn test",
    "publish:beta": "npm publish --no-git-tag-version --tag beta"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "jest": {
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "lib/**/*.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/test/fixtures"
    ],
    "testTimeout": 50000
  },
  "dependencies": {
    "@semrel-extra/topo": "^1.14.0",
    "blork": "^9.3.0",
    "cosmiconfig": "^8.3.6",
    "debug": "^4.3.4",
    "detect-indent": "^7.0.1",
    "detect-newline": "^4.0.1",
    "execa": "^7.1.1",
    "get-stream": "^6.0.1",
    "git-log-parser": "^1.2.0",
    "lodash-es": "^4.18.1",
    "meow": "^12.0.1",
    "promise-events": "^0.2.4",
    "resolve-from": "^5.0.0",
    "semantic-release": "^21.0.5",
    "semver": "^7.5.3",
    "signale": "^1.4.0",
    "stream-buffers": "^3.0.2"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.6.6",
    "@jest/globals": "^30.5.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.3",
    "@semantic-release/npm": "^10.0.4",
    "commitlint": "^17.6.6",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "file-url": "^4.0.0",
    "jest": "^30.5.2",
    "prettier": "^2.8.8",
    "tempy": "^3.0.0"
  },
  "resolutions": {
    "braces": "^3.0.3",
    "**/braces": "^3.0.3",
    "tar": "^7.5.21",
    "glob": "^12.0.0",
    "semver": "^7.6.0",
    "minimatch": "^9.0.7",
    "pacote": "^21.5.1",
    "js-yaml": "^4.3.2",
    "lodash-es": "^4.18.1",
    "flatted": "^3.4.2",
    "http-cache-semantics": "^4.3.0",
    "cross-spawn": "^7.0.5",
    "browserslist": "^4.28.7",
    "sigstore": "^4.1.1",
    "socks": "^2.8.10",
    "**/picomatch": "^2.3.2",
    "**/micromatch": "^4.0.8",
    "**/postcss-selector-parser": "^7.1.6",
    "**/@octokit/request": "^8.4.1",
    "**/diff": "^5.2.2",
    "**/@tootallnate/once": "^2.0.1"
  },
  "release": {
    "branch": "master",
    "verifyConditions": [
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git"
    ],
    "prepare": [
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git"
    ],
    "publish": [
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Simspace/multi-semantic-release"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
